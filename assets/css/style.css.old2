:root {
  --bg: #fffdf0; /* #fffdf0 #fff8d6; 6c9 */

  --text: #162b2a;

  --muted: #5f6f6a;

  --accent: #0091DA; /* #146c5c; */

  --heading: #338fbd; /* 3aa6da #2a6f8f; */

  --max-width: 720px;

   --font-sans: ui-sans-serif, system-ui, -apple-system,
               "Segoe UI", Roboto, Helvetica, Arial;
}


/* ===== GLOBAL BACKGROUND ===== */

html, body {
  background-color: var(--bg);
  margin: 0;
  min-height: 100%;
  color: var(--text);
  font-family: var(--font-sans);
  font-size: 18px;
  line-height: 1.7;
}


/* ===== CONTAINER ===== */

main {
  max-width: var(--max-width);
  margin: 5rem auto;
  padding: 0 1.25rem;
}


/* ===== HEADINGS (FORCED CONSISTENCY) ===== */

h1, h2, h3 {
  color: var(--heading) !important;
  font-family: "Space Grotesk", system-ui, sans-serif;
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin-top: 2.5rem;
  margin-bottom: 1rem;
}

h1 {
  font-size: 3rem;
  font-weight: 700;
}

h2 {
  font-size: 2rem;
  font-weight: 650;
}

h3 {
  font-size: 1.4rem;
  font-weight: 650;
}


/* ===== PARAGRAPHS ===== */

p {
  margin: 1.2rem 0;
}


/* ===== LINKS ===== */

a {
  color: var(--accent);
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}


/* ===== HEADER ===== */

header {
  max-width: var(--max-width);
  margin: 2rem auto 0;
  padding: 0 1.25rem;

  display: flex;
  justify-content: space-between;
  align-items: center;
}

header a {
  color: var(--text);
  font-weight: 600;
}

/* ===== MUTED TEXT ===== */

small {
  color: var(--muted);
}

/* ===== LISTS ===== */

ul {
  padding-left: 1.25rem;
}